    static String chuanHoa1(String s){
        StringBuilder sb = new StringBuilder(s);
        if(sb.charAt(1) == '/') sb.insert(0, '0');
        if(sb.charAt(4) == '/') sb.insert(3, '0');
        return sb.toString();
    }
    
    static String chuanHoa2(String s){
        StringBuilder sb = new StringBuilder(s);
        if(sb.charAt(1) == ':') sb.insert(0, '0');
        if(sb.length() < 5) sb.insert('3', '0');
        return sb.toString();
    }
